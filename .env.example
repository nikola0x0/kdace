# Walrus Memory (mainnet). Account ID is the MemWalAccount object, not the owner wallet.
MEMWAL_ACCOUNT_ID=
MEMWAL_PRIVATE_KEY=
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz

# Tatum Sui gateway (native gRPC). Testnet: sui-testnet-grpc.gateway.tatum.io:443
TATUM_API_KEY=
SUI_NETWORK=mainnet
TATUM_SUI_GRPC=sui-mainnet-grpc.gateway.tatum.io:443

# Referee (create with: npx tsx scripts/new-referee-key.ts) and the published ledger
SUI_REFEREE_KEY=
KDACE_PACKAGE_ID=
KDACE_RESOLVER_CAP=

# --- Fan accounts and fan picks ---------------------------------------------------------------
# Server-side (root .env for the tick, web/.env.local for `next dev`, Vercel project env, GitHub Actions).
# Supabase project URL and service role key (Supabase → Project Settings → API; the Vercel Supabase
# integration sets both). Service role key = server only, never NEXT_PUBLIC_. Empty = fan features off.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Web only (Vercel + web/.env.local). Random, 32+ characters each: openssl rand -hex 32
# SESSION_SECRET signs fan session cookies; LOCK_SECRET protects /api/lock (same value goes in Supabase Vault
# as kdace_lock_secret, see supabase/migrations/20261022000100_fan_lock_cron.sql).
SESSION_SECRET=
LOCK_SECRET=

# Browser (web only, public by design). Enoki public API key (portal.enoki.mystenlabs.com) and the Google
# OAuth client ID registered in that Enoki app. Without both, only regular Sui wallets are offered.
NEXT_PUBLIC_ENOKI_API_KEY=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Network the wallet picker starts on; keep it equal to SUI_NETWORK.
NEXT_PUBLIC_SUI_NETWORK=testnet
